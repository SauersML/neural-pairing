# NEURAL PAIRING: the FX stem. Noise-only voices (the oscillator parked at
# 8 Hz under each patch's high-pass, the shared noise source at full) shaped
# into the film's swells, risers, whooshes and crashes. Rendered first, then
# played back in score.song on the tape deck (sample=fx.wav) so the noise
# never leaks into the musical voices. 120 bpm: beat = 0.5 s.

bpm 120
gate 1.0
tail 3

automate noise
1

# 0.0 s: air swelling out of silence
track air vel=0.8 patch=fx-swell gain=0.5
0:8
automate air.attack
3.0
automate air.release
2.0
automate air.cutoff
300 2200:8@exp
automate air.resonance
0.7

# 8.0 / 22.0 / 29.5 / 50.0 / 55.6 s: crash bursts
track burst patch=fx-burst gain=2.0
R:16 0:4@1 0:4@0.55 R:20 0:4@0.8 R:11 0:2@0.35 R:39 0:4@1 R:7.2 0:4@0.55
automate burst.cutoff
11000 R:58.9 16000:0.1 R:2 9000:0.1 R:38.9 11000:0.1 R:11 7000:0.1

# risers: 8.4-9.9, 21.2-21.9, 43.0-46.0, 49.0-49.9 (each cut 100 ms before
# its hit, so the hit lands out of a breath of silence)
track rise patch=fx-swell gain=2.0
R:16.8 0:3.0 R:22.6 0:1.4 R:42.2 0:6 R:6 0:1.8
automate rise.gain
0.03 R:16.8 1:3.0@exp 0.03:0.01 R:22.59 0.8:1.4@exp 0.02:0.01 R:42.19 1:6@exp 0.03:0.01 R:5.99 1:1.8@exp
automate rise.cutoff
250 R:16.8 9000:3.0@exp 400:0.01 R:22.59 8000:1.4@exp 200:0.01 R:42.19 12000:6@exp 300:0.01 R:5.99 10000:1.8@exp

# 14.0-14.5 s: the dive, peaking on 14.5
track whoosh patch=fx-swell gain=2.0
R:28 0:1
automate whoosh.attack
0.42
automate whoosh.release
0.9
automate whoosh.resonance
2.2
automate whoosh.cutoff
500 R:28 5200:1@exp 500:2.5@exp

# 40.0 s: frost
track ice patch=fx-ice gain=1.2
R:80 0:6
automate ice.lfo_filter
1.2

# 46.0-49.5 s: the low tension under the near-silence
track low patch=fx-low gain=0.28
R:92 0:7
