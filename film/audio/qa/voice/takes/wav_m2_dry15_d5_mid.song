# take (wav modulator): vox_mode 2, vox_dry 0.15, chord d5, carrier mid
bpm 120
gate 0.98
tail 1.5
automate vox_mode
2
automate vox_level
1.0
automate vox_dry
0.15
automate reverb_wet
0.16
automate reverb_decay
0.6
track nv vox wav=qa/voice/neural_pairing_piper48k.wav wav_at=1
R:1 [D2 D3 A3 D4]:1 [D2 D3 A3 D4]:2
automate nv.waveform
2
automate nv.osc2_pitch
-12
automate nv.osc2_level
0.45
automate nv.detune
4
automate nv.cutoff
3000
automate nv.resonance
0.3
automate nv.sub
0.2
