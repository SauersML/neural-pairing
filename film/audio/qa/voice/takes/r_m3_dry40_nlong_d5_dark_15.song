# take: vox_mode 3, vox_dry 0.4, lyric nlong, chord d5, carrier dark
bpm 120
gate 0.95
tail 1.5
automate vox_mode
3
automate vox_level
1.0
automate vox_dry
0.4
automate vox_breath
0.1
automate vox_vibrato
0
automate vox_intonation
0.15
automate reverb_wet
0.16
automate reverb_decay
0.6
track nv vox vel=0.9
R:1 [D2 D3 A3 D4]:1.5=N:160@1.4-UW1:200-R-AH0-L:100 [D2 D3 A3 D4]:2.5=P:80@1.8-HH:45@0.7-EH1:200-R-IH0:110-NG:220.
automate nv.waveform
2
automate nv.osc2_pitch
-12
automate nv.osc2_level
0.5
automate nv.detune
4
automate nv.cutoff
1600
automate nv.resonance
0.4
automate nv.sub
0.3
