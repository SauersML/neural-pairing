# take: vox_mode 1, vox_dry 1.0, lyric slow_nuw, chord d3, carrier bright
bpm 120
gate 0.95
tail 1.5
automate vox_mode
1
automate vox_level
0.0
automate vox_dry
1.0
automate vox_breath
0.1
automate vox_vibrato
0
automate vox_intonation
0.15
automate reverb_wet
0.16
automate reverb_decay
0.6
track nv vox vel=0.9
R:1 D3:1.5=N:130-UW1:220-R-AH0:120-L:110 D3:2.5=P:80@1.8-EH1:220-R-IY0:120-NG:200.
automate nv.waveform
2
automate nv.osc2_pitch
12
automate nv.osc2_level
0.4
automate nv.detune
3
automate nv.cutoff
5000
automate nv.sub
0
