# ---------------------------------------------------------------- QUILL (glass pluck, mid, aeolian)
track quill vel=0.55 len=1 patch=quill reverb_send=0.3 echo_send=0.2 pan=-0.28 gain=0.65
# assembly: Quill's motif, D F A B-flat A (the minor-sixth sigh)
>ASSEMBLY R:0.75 D4:0.75@0.48 F4:0.75@0.5 A4:0.75@0.53 Bb4:1.25@0.58 A4:2@0.45
# the first pass: lockstep with Ember but in its own mode, then its own token
>PASS1 D4@0.42 F4@0.44 G4@0.46 A4@0.48 Bb4@0.5 C5@0.52 D5:0.5@0.6
# the hold: a fifth with Ember, the first consonance between them
>HOLD R:0.5 E4:3@0.34
# the bridges: odd connections (12.5, 13.5, 14.5, 15.5)
>BRIDGES R:1 F3@0.8 R:1 C4@0.8 R:1 F4@0.82 R:1 C5@0.84
# the slow pass: Quill receives at exchanges 2, 4, 6, 8
R:1.5 G4:1.5@0.78 R:2 Bb4:1.5@0.8 R:2.25 D5:1.5@0.8 R:2 F5:1.75@0.82
# 23.0 the token: both voices on the same D; then the fast passes (hocket)
>FAST D4:0.5@0.8 F4:0.5@0.55 R:0.5 E4:0.5@0.55
R:0.25 D4:0.25@0.5 R:0.25 C4:0.25@0.5 R:0.25 F4:0.25@0.55 R:0.25 D4:0.25@0.5 R:0.25 Bb3:0.25@0.55 R:0.25 F4:0.25@0.58 R:0.25 C#4:0.25@0.6 R:0.25 E4:0.25@0.62
# the read: Quill's states show their keys
>READ R:4 G4:0.25@0.4 R:0.25 A4:0.25@0.4 R:0.25 Bb4:0.25@0.42 R:0.25 C5:0.25@0.42 R:0.25 D5:0.25@0.44
# the secret: the lantern motif, D A G B-flat, twice
>SECRET D4:0.5@0.72 A4:0.5@0.7 G4:0.5@0.68 Bb4:2.5@0.72 D4:0.5@0.5 A4:0.5@0.48 G4:0.5@0.46 Bb4:1.5@0.5
# the mood: Quill's third rises, F -> F-sharp
>MOOD A4:0.5@0.5 F4:0.5@0.5 F#4:2@0.75 A4@0.55 D5:2@0.6 R:1 B4:2@0.55
# the games: Quill opens windows 1, 3, 5, 7, 9; then call and response
>GAMES A4:1.25@0.62 R:1.25 E4:1.25@0.6 R:1 B4:1.25@0.62 R:1.25 D5:1.25@0.62 R:1.25 C5:1.05@0.6
R:1.2 B4:0.5@0.55 D5:0.5@0.55 B4:1@0.5 R:2 D5:0.5@0.55 C5:0.5@0.55 A4:1@0.5 R:2 D5:1@0.58 C#5:1@0.6
# training: Quill and Ember trade single notes, then climb in octaves
>TRAIN R:1 A4:2@0.45 R:2 F4:2@0.45 R:1
>RISE R:4 A3@0.5 C#4@0.54 E4@0.58 G4@0.62 A4@0.66 C#5@0.7
# the proof: the theme (grown from the lantern motif), Quill an octave above Ember
>PROOF D4@0.8 A4@0.78 G4@0.76 Bb4@0.8 A4:2@0.78 F4@0.74 D4@0.72 G4:1.25@0.76 Bb4:0.75@0.8 D5:1.5@0.8 C5:0.5@0.74 A4:3@0.78 C#5@0.8
>TITLE D5:2@0.75 A4:2@0.68 D4:4@0.62
automate quill.gain
0.65 >BRIDGES 1.1:0.1 >READ 0.9:0.5 >SECRET 1.1:0.1 >TITLE R:0.6 0.55:0.2 R:2.9 1.1:0.3
automate quill.cutoff
1700 >READ 2300:0.1 >SECRET 1900:0.1 >PROOF 2100:0.1

# ---------------------------------------------------------------- EMBER (warm saw, low-mid, dorian)
track ember vel=0.55 len=1 patch=ember reverb_send=0.25 echo_send=0.15 pan=0.28 gain=0.6
# assembly: Ember's motif, D A B C A (the dorian raised sixth)
>ASSEMBLY R:1.5 D3:1@0.5 A3:1@0.52 B3:1@0.55 C4:1.25@0.55 A3:2@0.45
# the first pass: the same climb in its own mode (B-natural against Quill's B-flat)
>PASS1 D3@0.42 F3@0.44 G3@0.46 A3@0.48 B3@0.5 C4@0.52 D4:0.5@0.6
>HOLD A3:3@0.36
# the bridges: even connections (12.0, 13.0, 14.0, 15.0)
>BRIDGES D3@0.8 R:1 A3@0.8 R:1 D4@0.82 R:1 A4@0.84
# the slow pass: Ember receives at exchanges 1, 3, 5, 7
R:0.75 F3:1.5@0.8 R:2 A3:1.5@0.8 R:2 C4:1.5@0.82 R:2.25 E4:1.5@0.84 R:2
# 23.0 the token (same D as Quill), then the hocket
>FAST D4:0.5@0.8 R:0.5 A3:0.5@0.6 R:0.5
Bb2:0.25@0.6 R:0.25 F3:0.25@0.55 R:0.25 Bb2:0.25@0.6 R:0.25 A3:0.25@0.58 R:0.25 G2:0.25@0.62 R:0.25 D3:0.25@0.6 R:0.25 A2:0.25@0.64 R:0.25 E3:0.25@0.64 R:0.25
# the read: Ember's query beam slides up; later the values pour in
>READ R:1 D3:0.5@0.5 A4:2.5@0.55 R:4.5 D4:0.5@0.45 C4:0.5@0.45 Bb3:0.5@0.45 A3:0.5@0.45 G3:1.5@0.5
# 36.5: Ember plays the lantern motif back, exactly
>SECRET R:9 D4:0.5@0.72 A4:0.5@0.7 G4:0.5@0.68 Bb4:1.5@0.72
# the mood: Ember's third follows Quill's, F -> F-sharp at 39.5
R:2 A3:0.5@0.5 F3:0.5@0.5 F#3:2@0.75 B3:2@0.55 R:1
# the games: Ember opens windows 2, 4, 6, 8; then answers Quill
>GAMES R:1.25 D3:1.25@0.62 R:1.25 A3:1.25@0.6 R:1 G3:1.25@0.62 R:1.25 F3:1.1@0.6
R:4.4 A3:0.5@0.55 G3:0.5@0.55 E3:1@0.5 R:2 F3:0.5@0.55 G3:0.5@0.55 A3:1@0.5 R:2 E3:1@0.58 C#4:1@0.6
>TRAIN R:3 A3:2@0.45 R:2 F3:1@0.45
>RISE R:4 A2@0.5 C#3@0.54 E3@0.58 G3@0.62 A3@0.66 C#4@0.7
# 66.5: the real partner answers with the lantern, exactly
>DROP R:1 D4:0.5@0.45 A4:0.5@0.45 G4:0.5@0.42 Bb4:1.5@0.45
>PROOF D3@0.8 A3@0.78 G3@0.76 Bb3@0.8 A3:2@0.78 F3@0.74 D3@0.72 G3:1.25@0.76 Bb3:0.75@0.8 D4:1.5@0.8 C4:0.5@0.74 A3:3@0.78 C#4@0.8
>TITLE D4:2@0.75 A3:2@0.68 D4:4@0.62
automate ember.gain
0.6 >BRIDGES 1.4:0.1 >READ 1.15:0.5 >SECRET 1.4:0.1 >DROP 0.8:0.1 >PROOF 1.4:0.1 >TITLE R:0.6 0.7:0.2 R:2.9 1.4:0.3
automate ember.mono
1
automate ember.glide
0.025 >READ R:1.2 0.3:0.1 R:6.1 0.025:0.1 >SECRET 0.025:0.1   # QA: 0.3 s glide only for the D3->A4 query (26.5 s), off before the 30.25 s line

# ---------------------------------------------------------------- ostinato / arp (low pluck)
track ost vel=0.45 len=0.5 patch=nc-pluck reverb_send=0.15 echo_send=0.12 pan=0.05 duck=0.2
# the secret's forward pass: gold rising in Ember's core
>SECRET R:5 D2:0.5@0.3 F2:0.5@0.32 A2:0.5@0.34 D3:0.5@0.36 F3:0.5@0.38 A3:0.5@0.4 D4:0.5@0.42 R:0.5
# the games: Drive-style eighths
>GAMES D2 A2 D3 E3 F3 E3 D3 A2 G2 D3 G3 A3 B3 A3 G3 D3 D2 A2 D3 E3 F3 E3 D3 A2 G2 D3 G3 A3 B3 A3 G3 D3
Bb1 F2 Bb2 C3 D3 C3 Bb2 F2 A1 E2 A2 B2 C#3 B2 A2 E2
# training: the machine, in sixteenths
>TRAIN (D2:0.25 D3:0.25 A2:0.25 D3:0.25 F3:0.25 D3:0.25 A2:0.25 D3:0.25)x4
>ICE (D2:0.25 D3:0.25 G2:0.25 D3:0.25 Bb2:0.25 D3:0.25 G2:0.25 D3:0.25)x3
>RISE (Bb1:0.25 Bb2:0.25 F2:0.25 Bb2:0.25 D3:0.25 Bb2:0.25 F2:0.25 Bb2:0.25)x2 (A1:0.25 A2:0.25 E2:0.25 A2:0.25 C#3:0.25 A2:0.25 E2:0.25 A2:0.25)x3
>PROOF D2 A2 D3 E3 F3 E3 D3 A2 Bb1 F2 Bb2 C3 R:4.75 G2:0.5 D2:0.75 A1 E2 A2 B2 C#3 B2 A2 E2
# QA: a deep fast filter-env sweep at a low cutoff bends every pluck 15-27 cents flat;
# a shallower, slower sweep plus a small trim where the cutoff sits lowest
automate ost.filter_env
1.3
automate ost.filter_decay
0.4
automate ost.resonance
1.0
automate ost.pitch_shift: 0.12 during TRAIN,ICE base 0
automate ost.cutoff
500 >GAMES 700:0.1 >TRAIN 450:0.1 >ICE 380:1 >RISE 400:0.1 2600:10@exp >PROOF 800:0.1
automate ost.gain
0.75 >RISE 0.6:0.1 1.1:9.9@exp >PROOF 0.75:0.1

# ---------------------------------------------------------------- glass (the read, precise)
track glass vel=0.3 len=0.5 patch=nc-glass reverb_send=0.35 echo_send=0.1 pan=0.3 gain=1.4
>READ (A4@0.3 R:0.5 D5@0.22 R:1 E4@0.25 R:1)x1 (A4@0.28 R:0.5 D5@0.2 R:1 F4@0.24 R:1)x1 (Bb4@0.28 R:0.5 D5@0.2 R:1 G4@0.24 R:1)x1
automate glass.release
0.5
automate glass.decay
1.0

