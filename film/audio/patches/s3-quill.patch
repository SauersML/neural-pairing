# Score 3: Quill's signature. A glass PWM voice: a pulse whose width breathes
# on the LFO, a sine an octave up and a faint twelfth (both harmonic); the
# chorus send gives it width. The OTA filter
# blooms on each note and settles into a sustained, singing glow; a long
# release hands every note to the reverb. Attack is instant, so it speaks on
# the beat.
waveform 1
pulse_width 0.32
lfo_pwm 0.16
osc2_wave 0
osc2_pitch 12
osc2_level 0.34
osc3_wave 0
osc3_pitch 19
osc3_level 0.08
detune 3
unison 1
unison_detune 6
spread 0.6
circuit 1
key_track 0.6
cutoff 1300
resonance 0.9
drive 1.5
saturation 0.6
hpf 170
filter_env 1.5
filter_attack 0.004
filter_decay 0.7
filter_sustain 0.45
filter_release 1.0
lfo_filter 0.12
attack 0.004
decay 1.4
sustain 0.6
release 1.4
vel_filter 1.0
volume 0.55
